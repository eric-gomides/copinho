<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0a4a47" android:padding="14dp" android:gravity="center_vertical">
<TextView android:id="@+id/widget_app_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COPINHO" android:textColor="#9dd4c7" android:textSize="10sp" android:textStyle="bold"/>
<TextView android:id="@+id/widget_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00L / 4.0L" android:textColor="#ffffff" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp" android:background="#1a8273"><View android:id="@+id/widget_progress_fill" android:layout_width="0dp" android:layout_height="match_parent" android:background="#2ea395"/></FrameLayout>
<TextView android:id="@+id/widget_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#9dd4c7" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
</LinearLayout>
